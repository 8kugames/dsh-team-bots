# dsh-team-bots 本地运行的环境变量模板。
#
# 本地运行没有栈级配置文件：启动 dsh 前按需导出这些变量（或写进自己的
# shell 配置）。不要把 .env 放在仓库根目录——direnv、编辑器 dotenv 插件
# 或手动 `set -a; . .env` 会把 DSH_* 带进 `npm test` / `npm run dev`。
#
# 所有变量都可不设，缺省值见 src/config.js。

# 团队工作区根：项目目录、_the_bots 单聊区与团队
# 数据（.data）都在它下面。缺省 ~/.dsh/workspace/team-bots
#DSH_TEAM_WORKSPACE=

# 团队数据目录，缺省 <工作区>/.data
#DSH_TEAM_DATA=

# 调度限制：单次运行超时（毫秒）
DSH_TEAM_RUN_TIMEOUT_MS=900000

# 单次运行 token 上限，超出即中止；0 关闭
#DSH_TEAM_MAX_RUN_TOKENS=0

# 群聊回复压缩上限（字符），完整交付始终进任务评论
#DSH_TEAM_CHAT_MAX_CHARS=800

# 官方 Agent Teams 层：需要先给 profile 手动安装配套包再打开
#DSH_TEAM_AGENT_TEAM=0

# 模型价格覆盖（JSON，每百万 token）；内置 deepseek-flash / glm-5.3 /
# glm-5.3-flash / MiniMax-M3.1-Flash 的 CNY 价
#DSH_TEAM_MODEL_PRICES=[{"id":"deepseek-flash","hit":0.2,"miss":2,"out":8,"currency":"CNY"}]
