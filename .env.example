# dsh-team-bots 本地运行的环境变量模板。
#
# 本地运行没有栈级配置文件：启动 dsh 前按需导出这些变量（或写进自己的
# shell 配置）。不要把 .env 放在仓库根目录——direnv、编辑器 dotenv 插件
# 或手动 `set -a; . .env` 会把 DSH_* 带进 `npm test` / `npm run dev`。
#
# 所有变量都可不设，缺省值见 src/config.js。

# 团队工作区根：项目目录、_the_bots 单聊区与团队
# 数据（.data）都在它下面。缺省 ~/.dsh/workspace/team-bots
#DSH_TEAM_WORKSPACE=

# 团队数据目录，缺省 <工作区>/.data
#DSH_TEAM_DATA=

# 调度限制：单次运行超时（毫秒）：缺省 3600000（60 分钟）
#DSH_TEAM_RUN_TIMEOUT_MS=3600000

# 审批（提权）授权窗口（毫秒）：到时未决自动回 rejected。缺省 180000（3 分钟）
DSH_TEAM_APPROVAL_TIMEOUT_MS=180000

# 交付迁移待验收时是否自动派生子代理核验运行（DSHBOTS-113）。缺省 true（开）
#DSH_TEAM_AUTO_REVIEW_DELEGATE=true

# 一次性密钥运行时 TTL（毫秒）：批准后物化的明文 env 文件到期即焚。缺省 1800000（30 分钟）
#DSH_TEAM_SECRETS_TTL_MS=1800000

# 单次运行 token 上限，超出即中止；0 关闭
#DSH_TEAM_MAX_RUN_TOKENS=0

# 群聊回复压缩上限（字符），完整交付始终进任务评论
#DSH_TEAM_CHAT_MAX_CHARS=800

# Worker 会话使用的 agent preset（DSH 内置 id：standard/ptc/minimal/cordis）。
# 留空（缺省）= standard。Bot 级覆盖：Bot 配置弹窗「Agent 预设」下拉逐个设置，
# 留空即跟随这里的全局值。也可在全局配置页「运行参数」卡直接改。
#DSH_TEAM_WORKER_PRESET=

# 宿主集成工具面（MCP 服务器、引擎桥等）对团队 bot 按项目「按需」可见。缺省不启用：
# 工具面与宿主全局一致。要启用就配「前缀=工作区标记路径」映射（分号分隔）：登记了的
# 那几族默认对团队 bot 隐藏，项目工作区里有标记才放行；没登记的工具面不受影响。单聊不受影响。
# 示例（分号分隔；把前缀和标记路径换成自己实际安装的工具族与项目标记）：
#DSH_TEAM_TOOL_FAMILY_MARKERS=mcp__my-server__=.my-server;mybridge_=mybridge.project
# 额外隐藏（可选；空白/逗号/分号分隔）：另有不设放行标记、要对团队 bot 无条件隐藏的前缀时才配。
# 配了它，隐藏清单以它为准，上面登记的族只在项目工作区里有标记时放行。
#DSH_TEAM_HIDE_TOOL_PREFIXES=

# 原生 Agent Teams 层：需要先给 profile 手动安装配套包再打开
#DSH_TEAM_AGENT_TEAM=0

# 模型价格覆盖（JSON，每百万 token）；内置 deepseek-flash / glm-5.3 /
# glm-5.3-flash / MiniMax-M3.1-Flash 的 CNY 价
#DSH_TEAM_MODEL_PRICES=[{"id":"deepseek-flash","hit":0.2,"miss":2,"out":8,"currency":"CNY"}]
