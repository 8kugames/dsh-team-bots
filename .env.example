# Host DSH home is mounted into the container at /home/node/.dsh.
# This inherits the host's global providers, plugins and credentials.
# The team plugin uses the dedicated `team-bots` profile:
#   ~/.dsh/profiles/team-bots
# Docker Compose expands ${HOME} when the stack starts.
# If your DSH home is elsewhere, change the volume in docker-compose.yml.

# Model provider used by DSH. Add other provider keys in ~/.dsh/cordis.patch.yml.
DEEPSEEK_API_KEY=

# Optional: only set this to pin a DSH version for rollback or verification.
# Unset means "resolve the latest non-alpha DSH release at build time".
# DSH_VERSION=0.2.1-rc.5

# Optional npm registry mirror.
NPM_REGISTRY=https://registry.npmjs.org/

# Comma-separated hosts/IPs that may access the DSH API. Do not include a port.
DSH_TRUSTED_HOST=localhost,127.0.0.1

# Host port for the DSH Web UI.
DSH_TEAM_PORT=13080

# Project files and team metadata live here (/workspace/.data).
DSH_TEAM_WORKSPACE_DIR=/workspace

# Run the container as the owner of ~/.dsh and the workspace share.
# On macOS use: PUID=$(id -u) PGID=$(id -g)
PUID=1000
PGID=1000

# Scheduler limits.
# Global cap on concurrently running DSH sessions.
DSH_TEAM_MAX_RUNS=3
DSH_TEAM_RUN_TIMEOUT_MS=900000
# Per-run token ceiling; 0 disables it.
DSH_TEAM_MAX_RUN_TOKENS=0
# Kill a run that produced no event for this long; 0 disables it.
DSH_TEAM_STALL_TIMEOUT_MS=600000
# Group-chat replies are shortened to this many characters (full report goes to task comments).
DSH_TEAM_CHAT_MAX_CHARS=800

# Official Agent Teams layer. 1 lets each task session split work across named
# teammates in the same workspace. It replaces the subagent tools in this profile.
DSH_TEAM_AGENT_TEAM=0
DSH_TEAM_MAX_TEAMMATES=3

# WeChat (Tencent iLink) channel. 1 enables the WeChat card in Settings:
# scan the QR to bind, say "绑定" in WeChat to become admin, then receive
# task notifications and reply with 状态/详情/验收/驳回 commands.
DSH_TEAM_WECHAT=0

# Optional model prices override as JSON (per million tokens, provider optional).
# Defaults ship with deepseek-flash / glm-5.3 / glm-5.3-flash / MiniMax-M3.1-Flash in CNY.
# DSH_TEAM_MODEL_PRICES=[{"id":"deepseek-flash","hit":0.2,"miss":2,"out":8,"currency":"CNY"}]
