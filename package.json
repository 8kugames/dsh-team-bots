{
  "name": "dsh-team-bots",
  "version": "0.2.454",
  "description": "Project spaces, group chats, task boards, memory and usage for teams of DSH bots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8kugames/dsh-team-bots.git"
  },
  "homepage": "https://github.com/8kugames/dsh-team-bots#readme",
  "bugs": {
    "url": "https://github.com/8kugames/dsh-team-bots/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "index.js",
    "src/",
    "!src/**/*.ts",
    "scripts/doctor.mjs",
    "ui/",
    "!ui/**/*.ts",
    "vendor/",
    "cordis.patch.yml",
    "README.md",
    "docs/README.zh.md",
    "docs/assets/",
    "NOTICE",
    "LICENSE"
  ],
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test \"tests/*.test.js\" \"scripts/*.test.js\"",
    "release": "node scripts/release.mjs",
    "finalize": "node scripts/finalize.mjs",
    "predev": "npm run build",
    "dev": "node scripts/dev-server.mjs",
    "prestart": "npm run build",
    "start": "node scripts/dev-server.mjs",
    "prepack": "npm run build",
    "doctor": "node scripts/doctor.mjs",
    "profile:install": "node scripts/install-profile.mjs",
    "verify:agent-team": "node scripts/verify-agent-team.mjs",
    "backup": "node scripts/backup.mjs",
    "restore-check": "node scripts/restore-check.mjs",
    "load-test": "node scripts/load-test.mjs",
    "fault-test": "node scripts/fault-test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bots",
    "team",
    "tasks"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
